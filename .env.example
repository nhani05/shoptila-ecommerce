# ==========================================
# Shoptila — development environment template
# Copy to `.env` (never commit `.env`).
# Do NOT put real secrets here; these are local-only placeholders.
# ==========================================

# Database (PostgreSQL 16, us-01)
DB_NAME=shoptila
DB_USER=shoptila
DB_PASSWORD=local-dev-password
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/shoptila

# Backend HTTP port (đổi nếu 8080 đã bị chiếm; nhớ đổi cả proxy Vite)
SERVER_PORT=8080

# JWT — US-02 placeholder, unused by US-01
JWT_SECRET=
JWT_EXPIRATION_MS=

# VNPAY Sandbox — later features only, unused by US-01
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
